# Clé API Google AI Studio (Gratuite sur https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle par défaut (Recommandé : gemini-2.5-flash ou gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Environnement (development / production)
ENVIRONMENT=development
PORT=8000

# Webhooks Discord Multi-Salons
# 1. Salon #candidatures-soumises (Succès Easy Apply et portails envoyés)
DISCORD_WEBHOOK_SUBMITTED=https://discord.com/api/webhooks/...

# 2. Salon #actions-manuelles (Portails bloquants Workday/Captcha à faire en 1 clic)
DISCORD_WEBHOOK_BLOCKED=https://discord.com/api/webhooks/...

# 3. Salon #suivi-et-retours (Pipeline global et réponses en attente)
DISCORD_WEBHOOK_FOLLOWUP=https://discord.com/api/webhooks/...

# Webhook Discord par défaut (repli universel si les salons ci-dessus ne sont pas configurés)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_FALLBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# URL du Dashboard Vercel pour synchronisation instantanée du Tracker Web
VERCEL_SYNC_URL=https://votre-projet.vercel.app
